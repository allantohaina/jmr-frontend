Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Subdomain redirects -> pages login dediees (doit etre AVANT le rewrite vers out)
    RewriteCond %{HTTP_HOST} ^worker\.jmrtextile\.com$ [NC]
    RewriteRule ^$ /worker-login/ [R=302,L]

    RewriteCond %{HTTP_HOST} ^admin\.jmrtextile\.com$ [NC]
    RewriteRule ^$ /admin-login/ [R=302,L]

    # Serve the static Next export generated in /out while keeping the
    # cPanel document root on /public_html/frontend.
    RewriteCond %{REQUEST_URI} !^/out/
    RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -d
    RewriteRule ^(.*)$ out/$1 [L]

    RewriteCond %{REQUEST_URI} !^/out/
    RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}/index.html -f
    RewriteRule ^(.*?)/?$ out/$1/index.html [L]

    RewriteCond %{REQUEST_URI} !^/out/
    RewriteRule ^(.*)$ out/index.html [L]
</IfModule>

# Marque les assets Next hashés (_next/static) comme immuables.
# Pas de flag [L] : on continue vers les règles de serving ci-dessus.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(out/)?_next/static/ - [E=IMMUTABLE:1]
</IfModule>

<IfModule mod_headers.c>
    # Assets hashés : le nom change à chaque build -> cache 1 an sans risque.
    Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE
    # HTML / payloads RSC (.txt) / JSON : mêmes noms à chaque build ->
    # toujours revalidés, sinon le navigateur garde l'ancien build après un pull.
    <FilesMatch "\.(html|txt|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>
