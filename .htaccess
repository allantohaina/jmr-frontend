Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Subdomain redirects -> pages login dediees (doit etre AVANT le rewrite vers out)
    # Compat ancien bookmark /admin-log -> /admin-login/
    RewriteCond %{HTTP_HOST} ^admin\.jmrtextile\.com$ [NC]
    RewriteRule ^admin-log/?(.*)$ /admin-login/ [R=302,L]

    RewriteCond %{HTTP_HOST} ^worker\.jmrtextile\.com$ [NC]
    RewriteRule ^$ /worker-login/ [R=302,L]

    RewriteCond %{HTTP_HOST} ^admin\.jmrtextile\.com$ [NC]
    RewriteRule ^$ /admin-login/ [R=302,L]

    # Serve the static Next export generated in /out while keeping the
    # cPanel document root on /public_html/frontend.
    RewriteCond %{REQUEST_URI} !^/out/
    RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -d
    RewriteRule ^(.*)$ out/$1 [L]

    RewriteCond %{REQUEST_URI} !^/out/
    RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}/index.html -f
    RewriteRule ^(.*?)/?$ out/$1/index.html [L]

    RewriteCond %{REQUEST_URI} !^/out/
    RewriteRule ^(.*)$ out/index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # Cache à 0 (debug) : tout est revalidé à chaque visite,
    # le navigateur voit le nouveau build immédiatement après un pull.
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"

    # Sécurité : l'export Next est statique donc les headers() de
    # next.config.ts ne s'appliquent jamais en prod — on les porte ici.
    # (Même valeurs que next.config.ts + layout.tsx pour rester cohérent.)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
